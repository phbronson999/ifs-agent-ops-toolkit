{
  "manifest_version": 3,
  "name": "IFS Agent Ops Capture",
  "version": "0.1.0",
  "description": "Record a planned IFS Cloud demonstration task by task for the IFS Agent Ops toolkit (local only).",
  "minimum_chrome_version": "116",
  "permissions": ["debugger", "sidePanel", "storage", "tabs"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "sidepanel.html" },
  "action": { "default_title": "IFS Agent Ops capture" },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
