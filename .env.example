# IFS Cloud configuration
API_BASE_URL=https://your-instance.ifs.cloud
OAUTH_REALM=your-realm-name

# OAuth 2.0 public client (no client secret required)
OAUTH_CLIENT_ID=your-client-id

# Optional: skills directory. During migration Phases 0-4 the bundled skills live in
# src/ifs_agent_ops/skills — point SKILLS_DIR there (absolute path) to match prior behavior.
# SKILLS_DIR=/path/to/ifs-agent-ops-toolkit/src/ifs_agent_ops/skills

# Optional: export destination for export_api_data (defaults to ~/.ifs-mcp/exports)
# IFS_MCP_EXPORT_DIR=/path/to/exports

# Optional: scratch directory (defaults to ~/.ifs-mcp/scratch)
# IFS_MCP_SCRATCH_DIR=/path/to/scratch

# MCP server port (Streaming HTTP transport)
# MCP_SERVER_PORT=8000

# OAuth callback port (must match redirect URI registered with IFS Cloud)
# OAUTH_CALLBACK_PORT=3000

# TLS verification for IFS calls (API and token refresh).
# Default: verify against the operating system trust store, which trusts internal/corporate CAs.
# IFS_CA_BUNDLE=/path/to/ca-bundle.pem   # use this PEM bundle instead of the OS store
# IFS_TLS_VERIFY=false                   # disable verification (not recommended)
